# Sao thành .env (VPS, quyền 600) hoặc .env.local (máy dev). Không commit file thật.
DOMAIN=example.duckdns.org
APP_PUBLIC_URL=https://example.duckdns.org
GHCR_OWNER=max2min
IMAGE_TAG=change-me-commit-sha

POSTGRES_PASSWORD=change-me
POSTGRES_MIGRATOR_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me

U01_JWT_SECRET=change-me-at-least-32-bytes-random

# Brevo SMTP (demo/production): SMTP login + SMTP key, không phải API key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Các unit sau bổ sung: GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY, GOOGLE_SHARED_DRIVE_ID, GEMINI_API_KEY,
# YOUTUBE_API_KEY, PAYOS_CLIENT_ID, PAYOS_API_KEY, PAYOS_CHECKSUM_KEY, JUDGE0_AUTH_TOKEN.
