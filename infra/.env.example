# Sao thành .env (VPS, quyền 600) hoặc .env.local (máy dev). Không commit file thật.
DOMAIN=example.duckdns.org
APP_PUBLIC_URL=https://example.duckdns.org
GHCR_OWNER=max2min
IMAGE_TAG=change-me-commit-sha

POSTGRES_PASSWORD=change-me
POSTGRES_MIGRATOR_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me

# Brevo SMTP (demo, production): SMTP login và SMTP key, không phải API key. Local dùng Mailpit.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# U01: tên miền email trường (phân cách bằng dấu phẩy), khóa ký JWT ≥ 32 byte ngẫu nhiên.
U01_ALLOWED_EMAIL_DOMAINS=
U01_JWT_SECRET=

# U03: khóa ký FileRef ≥ 32 byte; Google Drive (JSON key service account mã hóa base64);
# backup database: thư mục Drive riêng, public key RSA của người vận hành, mật khẩu role backup_reader.
U03_FILEREF_SECRET=
U03_REQUIRE_DRIVE=true
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_BACKUP_FOLDER_ID=
U03_BACKUP_PUBLIC_KEY=
BACKUP_DB_PASSWORD=

# U06: khóa AES-256 mã hóa API key AI (base64 32 byte).
U06_AI_KEY_ENCRYPTION_KEY=

# U14: trần email thông báo mỗi ngày.
U14_EMAIL_DAILY_CAP=300
