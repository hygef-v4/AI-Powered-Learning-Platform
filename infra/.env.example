# Sao thành .env (VPS, quyền 600) hoặc .env.local (máy dev). Không commit file thật.
DOMAIN=example.duckdns.org
APP_PUBLIC_URL=https://example.duckdns.org
GHCR_OWNER=max2min
# SEO: production để true (mặc định); Google Search Console xác minh bằng thẻ meta thì dán phần content vào đây.
SEO_INDEXABLE=true
GOOGLE_SITE_VERIFICATION=
IMAGE_TAG=change-me-commit-sha

POSTGRES_PASSWORD=change-me
POSTGRES_MIGRATOR_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me

# Brevo SMTP (demo, production): SMTP login và SMTP key, không phải API key. Local dùng Mailpit.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Mạng chặn SMTP đi ra ngoài (một số VPS trong nước): đặt MAIL_TRANSPORT=brevo-api và điền API key của Brevo
# (SMTP & API > API Keys). Khi đó SMTP_USER, SMTP_PASSWORD bỏ trống được; SMTP_FROM vẫn bắt buộc.
MAIL_TRANSPORT=smtp
BREVO_API_KEY=

# U01: khóa ký JWT ≥ 32 byte ngẫu nhiên. Email đăng nhập thuộc tên miền nào cũng được.
U01_JWT_SECRET=
# U01: Admin đầu tiên, tạo ở trạng thái chờ kích hoạt (không có mật khẩu mặc định); tự kích hoạt bằng OTP.
U01_BOOTSTRAP_ADMIN_EMAIL=
U01_BOOTSTRAP_ADMIN_NAME=

# U03: khóa ký FileRef ≥ 32 byte; Google Drive (JSON key service account mã hóa base64);
# backup database (base backup và WAL, chỉ lưu trên Drive): thư mục Drive riêng, mật khẩu role backup_replicator;
# public key RSA tùy chọn, đặt thì base backup và WAL được mã hóa.
U03_FILEREF_SECRET=
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=
GOOGLE_SHARED_DRIVE_ID=
# Hoặc Drive cá nhân (Gmail): OAuth client (Web application) và refresh token scope drive.file;
# app tự tạo thư mục "AI Learning Platform" trong My Drive, backup nằm trong thư mục con "backups".
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
# Thư mục gốc trên My Drive: đặt tên (app tự tạo, mặc định "AI Learning Platform"), hoặc id thư mục
# do app tạo từ trước; id không truy cập được thì quay về theo tên. Không nhận id thư mục tạo tay (scope drive.file).
GOOGLE_DRIVE_FOLDER_NAME=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_BACKUP_FOLDER_ID=
U03_BACKUP_PUBLIC_KEY=
BACKUP_DB_PASSWORD=

# U06: khóa AES-256 mã hóa API key AI (base64 32 byte, tạo bằng: openssl rand -base64 32).
# Bắt buộc ở môi trường thật; thiếu thì không lưu hay dùng được khóa API (xem docs/runbooks/ai-key-encryption.md).
U06_AI_KEY_ENCRYPTION_KEY=
# Chỉ đặt khi đổi khóa: khóa mới mã hóa key lưu từ đây; giữ khóa cũ tới khi mọi key đã lưu lại.
U06_AI_KEY_ENCRYPTION_KEY_V2=

# U14: trần email thông báo mỗi ngày.
U14_EMAIL_DAILY_CAP=300

# Pool kết nối PostgreSQL (Hikari): backend 20, worker 10; tổng của cả hai phải dưới max_connections (100).
BACKEND_DB_POOL_MAX=20
WORKER_DB_POOL_MAX=10
# Thời gian tối đa một request chờ kết nối khi pool đang bận, mili giây (backend và worker).
DB_CONNECTION_TIMEOUT=10000
# U03: nhịp quét việc hẹn giờ của worker (mở/đóng bài, tự nộp, lịch backup), mili giây, tính từ khi lượt trước xong.
U03_SCAN_DELAY_MS=15000
