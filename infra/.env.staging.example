# Staging trên VPS: sao thành /opt/platform-staging/infra/.env (quyền 600). Không commit file thật.
# Mọi mật khẩu và khóa phải KHÁC production. Tạo bằng: openssl rand -base64 32
# Xem docs/runbooks/deploy-staging.md.
# Bắt buộc giữ ba dòng này: docker-compose.yml khai "name: platform" của production. Thiếu chúng thì
# "docker compose --env-file .env ..." chạy trong thư mục staging sẽ tác động lên container production.
COMPOSE_PROJECT_NAME=platform-staging
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.staging.yml

DOMAIN=staging.example.com
# Có cổng 8443: dùng trong link email và kiểm tra Origin.
APP_PUBLIC_URL=https://staging.example.com:8443
GHCR_OWNER=hygef-v4
# SHA đầy đủ của commit trên nhánh staging đã qua CI (job images).
IMAGE_TAG=

POSTGRES_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_APP_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# Email đi vào Mailpit của staging (docker-compose.staging.yml), không cần Brevo.
SMTP_FROM=no-reply@staging.example.com

U01_JWT_SECRET=
# Admin đầu tiên của staging; OTP kích hoạt đọc ở https://<DOMAIN>:8443/mailpit/.
U01_BOOTSTRAP_ADMIN_EMAIL=
U01_BOOTSTRAP_ADMIN_NAME=Quản trị viên staging

U03_FILEREF_SECRET=
# Tệp lưu ở volume platform-staging_files-staging; không dùng Google Drive, không backup lên Drive.
U03_REQUIRE_DRIVE=false

# Khóa mã hóa API key AI riêng cho staging. Nhóm kiểm thử dùng key AI thử, có giới hạn.
U06_AI_KEY_ENCRYPTION_KEY=

U14_EMAIL_DAILY_CAP=300
