# Staging: chỉ HTTPS, publish ra cổng 8443 của VPS (docker-compose.staging.yml). Cổng 80 trong container chỉ cho
# healthcheck. Không đặt HSTS để không ảnh hưởng tên miền production.
server {
    listen 80;
    server_name _;

    location = /nginx-health {
        access_log off;
        return 200 "ok";
    }

    location / {
        return 404;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Truy cập bằng HTTP vào cổng HTTPS: đưa về đúng địa chỉ.
    error_page 497 =301 https://$host:8443$request_uri;

    include /etc/nginx/snippets/security-headers.conf;

    # Hộp thư Mailpit (OTP, thông báo) cho nhóm kiểm thử; mật khẩu chung trong infra/staging-htpasswd.
    location /mailpit/ {
        auth_basic "Staging mail";
        auth_basic_user_file /etc/nginx/staging-htpasswd;
        set $mailpit_upstream http://mailpit:8025;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_pass $mailpit_upstream;
    }

    include /etc/nginx/snippets/locations.conf;
}
