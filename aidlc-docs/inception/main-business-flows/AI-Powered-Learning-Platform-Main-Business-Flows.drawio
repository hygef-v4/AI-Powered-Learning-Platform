        <mxCell id="bf-03-lt4" value="Decision: System check, or actor decision in its lane" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2606" y="850" width="340" height="20" as="geometry" /></mxCell>
        <mxCell id="bf-03-foot" value="&lt;b&gt;Revision 2026-11-22&lt;/b&gt; · five main business flows for Report 3 (SRS); replaces BF-01–BF-12 of 2026-10-30 (archived in superseded-2026-10-30/). Source view, not runtime acceptance." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="868" width="2982" height="22" as="geometry" /></mxCell>
