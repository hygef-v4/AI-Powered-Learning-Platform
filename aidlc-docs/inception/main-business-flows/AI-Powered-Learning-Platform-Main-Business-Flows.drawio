        <mxCell id="bf-03-lg3" value="" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;html=1;" vertex="1" parent="1"><mxGeometry x="2572" y="832" width="24" height="16" as="geometry" /></mxCell>
        <mxCell id="bf-03-lt3" value="System activity (automated by ALAP)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2606" y="830" width="340" height="20" as="geometry" /></mxCell>
