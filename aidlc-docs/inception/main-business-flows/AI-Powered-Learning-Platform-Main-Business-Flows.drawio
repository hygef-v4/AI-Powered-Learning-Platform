        <mxCell id="bf-02-lg1" value="" style="ellipse;aspect=fixed;fillColor=#EA6B66;strokeColor=#B85450;strokeWidth=3;html=1;" vertex="1" parent="1"><mxGeometry x="2390" y="792" width="18" height="18" as="geometry" /></mxCell>
        <mxCell id="bf-02-lt1" value="End event (business outcome)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2424" y="790" width="340" height="20" as="geometry" /></mxCell>
        <mxCell id="bf-02-lg2" value="" style="rounded=1;fillColor=#FFFFFF;strokeColor=#82B366;html=1;" vertex="1" parent="1"><mxGeometry x="2390" y="812" width="24" height="16" as="geometry" /></mxCell>
