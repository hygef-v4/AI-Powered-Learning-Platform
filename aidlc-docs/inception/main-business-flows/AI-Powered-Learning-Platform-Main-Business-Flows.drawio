        <mxCell id="bf-03-note" value="&lt;b&gt;Modeling convention.&lt;/b&gt; Each lane is a role responsible for its activities. The &lt;b&gt;System&lt;/b&gt; lane is included only to show the automated processing performed by ALAP: checking conditions, validating data, evaluating eligibility, saving information, updating status and sending notifications. Actor lanes contain only human work: entering data, selecting information, viewing results and making decisions that need human judgement. External lanes are services outside ALAP. Numbers follow the activity table." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#999999;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="772" width="2542" height="84" as="geometry" /></mxCell>
        <mxCell id="bf-03-lg0" value="" style="ellipse;aspect=fixed;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="2572" y="772" width="18" height="18" as="geometry" /></mxCell>
        <mxCell id="bf-03-lt0" value="Start event (trigger)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2606" y="770" width="340" height="20" as="geometry" /></mxCell>
        <mxCell id="bf-03-lg1" value="" style="ellipse;aspect=fixed;fillColor=#EA6B66;strokeColor=#B85450;strokeWidth=3;html=1;" vertex="1" parent="1"><mxGeometry x="2572" y="792" width="18" height="18" as="geometry" /></mxCell>
        <mxCell id="bf-03-lt1" value="End event (business outcome)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2606" y="790" width="340" height="20" as="geometry" /></mxCell>
        <mxCell id="bf-03-lg2" value="" style="rounded=1;fillColor=#FFFFFF;strokeColor=#82B366;html=1;" vertex="1" parent="1"><mxGeometry x="2572" y="812" width="24" height="16" as="geometry" /></mxCell>
