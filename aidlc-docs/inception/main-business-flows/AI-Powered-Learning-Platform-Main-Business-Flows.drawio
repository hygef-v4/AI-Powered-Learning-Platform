        <mxCell id="bf-02-lg3" value="" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;html=1;" vertex="1" parent="1"><mxGeometry x="2390" y="832" width="24" height="16" as="geometry" /></mxCell>
