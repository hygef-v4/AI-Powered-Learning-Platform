        <mxCell id="bf-04-edge-24" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bf-04-n17" target="bf-04-e1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bf-04-note" value="&lt;b&gt;Modeling convention.&lt;/b&gt; Each lane is a role responsible for its activities. The &lt;b&gt;System&lt;/b&gt; lane is included only to show the automated processing performed by ALAP: checking conditions, validating data, evaluating eligibility, saving information, updating status and sending notifications. Actor lanes contain only human work: entering data, selecting information, viewing results and making decisions that need human judgement. External lanes are services outside ALAP. Numbers follow the activity table." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFFFF;strokeColor=#999999;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="596" width="3088" height="84" as="geometry" /></mxCell>
        <mxCell id="bf-04-lg0" value="" style="ellipse;aspect=fixed;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="3118" y="596" width="18" height="18" as="geometry" /></mxCell>
        <mxCell id="bf-04-lt0" value="Start event (trigger)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3152" y="594" width="340" height="20" as="geometry" /></mxCell>
        <mxCell id="bf-04-lg1" value="" style="ellipse;aspect=fixed;fillColor=#EA6B66;strokeColor=#B85450;strokeWidth=3;html=1;" vertex="1" parent="1"><mxGeometry x="3118" y="616" width="18" height="18" as="geometry" /></mxCell>
        <mxCell id="bf-04-lt1" value="End event (business outcome)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3152" y="614" width="340" height="20" as="geometry" /></mxCell>
        <mxCell id="bf-04-lg2" value="" style="rounded=1;fillColor=#FFFFFF;strokeColor=#82B366;html=1;" vertex="1" parent="1"><mxGeometry x="3118" y="636" width="24" height="16" as="geometry" /></mxCell>
        <mxCell id="bf-04-lt2" value="Actor activity (human work)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3152" y="634" width="340" height="20" as="geometry" /></mxCell>
        <mxCell id="bf-04-lg3" value="" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;html=1;" vertex="1" parent="1"><mxGeometry x="3118" y="656" width="24" height="16" as="geometry" /></mxCell>
        <mxCell id="bf-04-lt3" value="System activity (automated by ALAP)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3152" y="654" width="340" height="20" as="geometry" /></mxCell>
        <mxCell id="bf-04-lg4" value="" style="rhombus;fillColor=#FFE6CC;strokeColor=#D79B00;html=1;" vertex="1" parent="1"><mxGeometry x="3118" y="676" width="26" height="16" as="geometry" /></mxCell>
        <mxCell id="bf-04-lt4" value="Decision: System check, or actor decision in its lane" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3152" y="674" width="340" height="20" as="geometry" /></mxCell>
        <mxCell id="bf-04-foot" value="&lt;b&gt;Revision 2026-11-22&lt;/b&gt; · five main business flows for Report 3 (SRS); replaces BF-01–BF-12 of 2026-10-30 (archived in superseded-2026-10-30/). Source view, not runtime acceptance." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="692" width="3528" height="22" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
