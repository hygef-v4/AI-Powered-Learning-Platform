<diagram id="bf01" name="BF-01 Login and Session Management"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="730" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="BF-01  Login and Session Management" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F4E78;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="2220" height="38" as="geometry"/></mxCell><mxCell id="trigger" value="Trigger: The user has an institution-issued account and enters an institutional email and password." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="2220" height="28" as="geometry"/></mxCell><mxCell id="endCondition" value="End condition: The user enters the system with the correct role or receives a safe error; the Redis session can be revoked." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="94" width="2220" height="34" as="geometry"/></mxCell><mxCell id="lane-bg-0" value="" style="rounded=0;html=1;fillColor=#F3F9EE;strokeColor=#B7B7B7;" vertex="1" parent="1"><mxGeometry x="35" y="145" width="2230" height="170" as="geometry"/></mxCell><mxCell id="lane-label-0" value="User" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="35" y="145" width="170" height="170" as="geometry"/></mxCell><mxCell id="lane-bg-1" value="" style="rounded=0;html=1;fillColor=#FFF9E6;strokeColor=#B7B7B7;" vertex="1" parent="1"><mxGeometry x="35" y="315" width="2230" height="170" as="geometry"/></mxCell><mxCell id="lane-label-1" value="Backend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6A3;strokeColor=#D6B656;fontSize=13;font